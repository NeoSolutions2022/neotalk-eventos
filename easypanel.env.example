# Domínios públicos configurados na aba Domains do EasyPanel.
APP_PUBLIC_ORIGIN=https://neotalk-eventos.k3p3ex.easypanel.host
API_PUBLIC_ORIGIN=https://neotalk-eventos-api.k3p3ex.easypanel.host

# Segredos: cadastre na aba Environment; nunca faça commit dos valores reais.
POSTGRES_PASSWORD=gere-uma-senha-forte
NEOTALK_API_KEY=preencha-no-easypanel
OPENAI_API_KEY=preencha-no-easypanel

# Integrações e parâmetros não secretos.
NEOTALK_API_BASE_URL=https://infra-neotalk-api.k3p3ex.easypanel.host
NEOTALK_API_TIMEOUT_SECONDS=30
NEOTALK_MVP_POSE_FPS=24
NEOTALK_VIDEO_SUBMIT_PATH=/sign-process-type
NEOTALK_VIDEO_STATUS_PATH=/task-status-type/{task_id}
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
NEXT_PUBLIC_AVATAR_WIDGET_URL=https://infra-avatar3d-oficial.k3p3ex.easypanel.host/widget
